# Airbnb iCal URL (get this from your Airbnb listing calendar settings)
AIRBNB_ICAL_URL=https://www.airbnb.com/calendar/ical/XXXXXXXX.ics?s=XXXXXXXX

# Email (SMTP) configuration - for sending/receiving guest emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FORWARD_TO_EMAIL=your-personal-email@gmail.com

# Twilio (SMS) configuration - for forwarding guest texts
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
FORWARD_TO_PHONE=+1234567890
